# Copier en .env pour personnaliser (facultatif : ces valeurs sont les défauts).
POSTGRES_DB=chinese
POSTGRES_USER=chinese
POSTGRES_PASSWORD=chinese
APP_PORT=8000
DB_PORT=5432

# Premier administrateur, créé au premier démarrage (mot de passe vide : généré et écrit
# dans le journal de l'application). Ne sert plus une fois le compte créé.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
